# Required Discord bot token
TOKEN=your_discord_bot_token

# Required: your Discord user ID; invalid/missing values deny owner-only access
OWNER_ID=123456789012345678

# Google Sheets configuration
GOOGLE_SHEETS_ID=your_google_spreadsheet_id
GOOGLE_SHEETS_TAB=Sheet1
# Paste the service-account JSON as one line (valid JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}

# Optional comma-separated role names used by the existing configuration
EDITOR_ROLE_NAMES=editor

# Optional logging level
LOG_LEVEL=INFO

# Components V2 custom application emojis (optional).
# Set NAME and ID to the exact emoji name/ID from the Discord Developer Portal.
# Animated application emojis: set the matching ANIMATED value to true.
EMOJI_SUCCESS_NAME=
EMOJI_SUCCESS_ID=
EMOJI_SUCCESS_ANIMATED=false
EMOJI_ERROR_NAME=
EMOJI_ERROR_ID=
EMOJI_ERROR_ANIMATED=false
EMOJI_WARNING_NAME=
EMOJI_WARNING_ID=
EMOJI_WARNING_ANIMATED=false
EMOJI_BOX_NAME=
EMOJI_BOX_ID=
EMOJI_BOX_ANIMATED=false
EMOJI_TYPE_NAME=
EMOJI_TYPE_ID=
EMOJI_TYPE_ANIMATED=false
EMOJI_TIER_NAME=
EMOJI_TIER_ID=
EMOJI_TIER_ANIMATED=false
EMOJI_COUNTRY_NAME=
EMOJI_COUNTRY_ID=
EMOJI_COUNTRY_ANIMATED=false
EMOJI_SOURCE_NAME=
EMOJI_SOURCE_ID=
EMOJI_SOURCE_ANIMATED=false
EMOJI_REPORT_NAME=
EMOJI_REPORT_ID=
EMOJI_REPORT_ANIMATED=false
